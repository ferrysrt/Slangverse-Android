# Backend only. Keep secrets out of GitHub and Android.
PORT=8787
HOST=127.0.0.1
LLM_PROVIDER=mock
# For a real provider, set LLM_PROVIDER=openai-compatible and configure:
# LLM_API_KEY=YOUR_PRIVATE_KEY
# LLM_MODEL=openai/gpt-6-luna
# LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=20000
LLM_RETRIES=1

# OpenRouter (server-side only). Never ship these variables to Android.
# LLM_PROVIDER=openai-compatible
# GPT-6 Luna regular (non-batch). The batch suffix is NOT used for real-time sessions.
# LLM_MODEL=openai/gpt-6-luna
# LLM_API_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT_MS=120000
# LLM_MAX_TOKENS=8000
# LLM_REASONING_EFFORT=low
# Set LLM_API_KEY securely in your deployment environment.

# OPTIONAL on trusted local Wi-Fi; REQUIRED for Render cloud Blueprint.
# Do NOT use an OpenRouter key as the client access token.
# SLANGVERSE_REQUIRE_TOKEN=true
# SLANGVERSE_CLIENT_TOKEN=A_DIFFERENT_RANDOM_32_CHAR_OR_LONGER_TOKEN

# Safety fuse per backend process (resets after a restart, NOT a billing cap).
SLANGVERSE_MAX_LLM_SESSIONS=20
