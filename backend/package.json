{
  "name": "slangverse-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "start:env": "node --env-file=.env src/server.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test": "node --test",
    "dataset:refresh": "node dataset/refresh.mjs",
    "dataset:migrate": "node dataset/migrate.mjs",
    "bank:publish": "node scripts/publish-mixed-bank.mjs",
    "bank:try": "node --env-file=.env scripts/try-mixed-pack.mjs",
    "bank:grow": "node --env-file=.env scripts/generate-mixed-pack-batch.mjs",
    "questions:analyze": "node scripts/analyze-mixed-attempt.mjs",
    "experiments:report": "node scripts/report-experiments.mjs",
    "bank:export": "node scripts/export-static-demo-bank.mjs public-question-bank"
  },
  "engines": {
    "node": ">=20"
  }
}
